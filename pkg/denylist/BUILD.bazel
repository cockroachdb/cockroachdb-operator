load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "denylist",
    srcs = ["file.go"],
    importpath = "github.com/cockroachlabs/cockroach-enterprise-operator/pkg/denylist",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_cockroachdb_errors//:errors",
        "@in_gopkg_yaml_v2//:yaml_v2",
    ],
)

go_test(
    name = "denylist_test",
    srcs = ["file_test.go"],
    embed = [":denylist"],
    deps = [
        "@com_github_stretchr_testify//require",
        "@in_gopkg_yaml_v2//:yaml_v2",
    ],
)
