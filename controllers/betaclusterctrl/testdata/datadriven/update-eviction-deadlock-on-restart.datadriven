	Disk size: 5Gi
	Assigned K8s Node: ''
	Spec K8s Node: ''
	PodReady        True     2023-01-01 00:07:00 +0000 UTC
	PodRunning      True     2023-01-01 00:01:00 +0000 UTC
	PodNeedsUpdate  False    2023-01-01 00:07:00 +0000 UTC
CrdbNode/crdb-1
	Desired Revision: "b1dd166a2e210c99"
	Generation: 1, Observed: 1
	Disk size: 5Gi
	Assigned K8s Node: ''
	Spec K8s Node: ''
	PodReady        True     2023-01-01 00:01:00 +0000 UTC
	PodRunning      True     2023-01-01 00:01:00 +0000 UTC
