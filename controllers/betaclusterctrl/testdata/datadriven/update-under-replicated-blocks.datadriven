CrdbNode/crdb-2
	Desired Revision: "b1dd166a2e210c99"
	Generation: 1, Observed: 1
	Disk size: 5Gi
	Assigned K8s Node: ''
	Spec K8s Node: ''
	PodReady        True     2023-01-01 00:01:00 +0000 UTC
	PodRunning      True     2023-01-01 00:01:00 +0000 UTC

# Report under-replicated ranges. The next reconcile must not advance any node to
# the new revision, and repeating it must be a no-op.
set-under-replicated count=5
----
CrdbCluster/crdb
	Current Revision:  "3e74844d6d3e70ae"
	Previous Revision: "b1dd166a2e210c99"
