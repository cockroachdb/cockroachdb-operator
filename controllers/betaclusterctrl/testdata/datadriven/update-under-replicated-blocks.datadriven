# Test that under-replicated ranges hold off a rolling restart. When the cluster
# has under-replicated ranges, the operator pauses the rollout so it doesn't take
# down another node and push those ranges to unavailable. Once the ranges clear,
# the rollout proceeds one node at a time.

create-cluster name=crdb
----
CrdbCluster/crdb
	Current Revision:  "b1dd166a2e210c99"
	Previous Revision: "b1dd166a2e210c99"
	Spec Image:        "cockroachdb/cockroach:v24.1.0"
	Current Version:   ""
CrdbNode/crdb-0
	Desired Revision: "b1dd166a2e210c99"
	Generation: 1, Observed: 1
	Disk size: 5Gi
	Assigned K8s Node: ''
	Spec K8s Node: ''
	PodReady        True     2023-01-01 00:01:00 +0000 UTC
	PodRunning      True     2023-01-01 00:01:00 +0000 UTC
CrdbNode/crdb-1
	Desired Revision: "b1dd166a2e210c99"
	Generation: 1, Observed: 1
	Disk size: 5Gi
	Assigned K8s Node: ''
	Spec K8s Node: ''
	PodReady        True     2023-01-01 00:01:00 +0000 UTC
	PodRunning      True     2023-01-01 00:01:00 +0000 UTC
CrdbNode/crdb-2
	Desired Revision: "b1dd166a2e210c99"
	Generation: 1, Observed: 1
	Disk size: 5Gi
	Assigned K8s Node: ''
	Spec K8s Node: ''
	PodReady        True     2023-01-01 00:01:00 +0000 UTC
	PodRunning      True     2023-01-01 00:01:00 +0000 UTC

# Change the image so a rolling update is pending.
set-cluster-image name=crdb image=cockroachdb/cockroach:v24.1.1
----
