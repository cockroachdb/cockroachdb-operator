# Test that version validation self-heals when the job pod is garbage-collected
# before the operator can read its logs. The operator should delete the stale
# job and retry on the next reconcile rather than permanently blocking the
# upgrade with a rejected-image annotation.

# Set up a cluster on v24.1.0 with a known running version.
create-cluster name=test-cluster image=cockroachdb/cockroach:v24.1.0
