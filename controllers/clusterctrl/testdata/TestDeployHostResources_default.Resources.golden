[
	{
		"apiVersion": "apps/v1",
		"kind": "Deployment",
		"metadata": {
			"annotations": {},
			"creationTimestamp": null,
			"labels": {
				"app": "sqlproxy"
			},
			"name": "sqlproxy",
			"namespace": "test-ns",
			"ownerReferences": [
				{
					"apiVersion": "crdb.cockroachlabs.com/v1beta1",
					"controller": true,
					"kind": "CrdbCluster",
					"name": "test-cluster",
					"uid": "\u003credacted\u003e"
				}
			]
		},
		"spec": {
			"replicas": 3,
			"selector": {
				"matchLabels": {
					"app": "sqlproxy"
				}
			},
			"strategy": {
				"rollingUpdate": {
					"maxSurge": "50%"
				},
				"type": "RollingUpdate"
			},
			"template": {
				"metadata": {
					"creationTimestamp": null,
					"labels": {
						"app": "sqlproxy"
					}
				},
				"spec": {
					"affinity": {
						"podAntiAffinity": {
							"preferredDuringSchedulingIgnoredDuringExecution": [
								{
									"podAffinityTerm": {
										"labelSelector": {
											"matchExpressions": [
												{
													"key": "app",
													"operator": "In",
													"values": [
														"sqlproxy"
													]
												}
											]
										},
										"topologyKey": "kubernetes.io/hostname"
									},
									"weight": 1
								}
							]
						}
					},
					"containers": [
						{
							"command": [
								"/bin/bash",
								"-ecx",
								"exec /cockroach/cockroach mt start-proxy --listen-addr=0.0.0.0:26257 --listen-cert=/cockroach/cockroach-certs/external.crt --listen-key=/cockroach/cockroach-certs/external.key --denylist-file=/cockroach/config/denylist.yml --directory=:8081 --log=\"{ sinks : { stderr : { filter : info } } }\""
							],
							"image": "us-docker.pkg.dev/cockroach-cloud-images/cockroachdb/cockroach:v24.2.0-cloudonly.1",
							"lifecycle": {
								"preStop": {
									"exec": {
										"command": [
											"/bin/sh",
											"-c",
											"PID=$(ls -l /proc/*/exe 2\u003e /dev/null | grep cockroach/cockroach | sed -E 's/^.*proc\\/([0-9]+).*$/\\1/g'); kill -s TERM $PID; sleep 60"
										]
									}
								}
							},
							"livenessProbe": {
								"httpGet": {
									"path": "/_status/healthz",
									"port": 8080,
									"scheme": "HTTP"
								},
								"initialDelaySeconds": 5,
								"periodSeconds": 10,
								"timeoutSeconds": 5
							},
							"name": "sqlproxy",
							"ports": [
								{
									"containerPort": 26257,
									"name": "sql",
									"protocol": "TCP"
								},
								{
									"containerPort": 26259,
									"name": "sql-pp",
									"protocol": "TCP"
								},
								{
									"containerPort": 8080,
									"name": "prometheus",
									"protocol": "TCP"
								}
							],
							"resources": {
								"requests": {
									"memory": "50Mi"
								}
							},
							"securityContext": {
								"allowPrivilegeEscalation": false,
								"capabilities": {
									"drop": [
										"ALL"
									]
								},
								"privileged": false,
								"readOnlyRootFilesystem": true
							},
							"volumeMounts": [
								{
									"mountPath": "/cockroach/cockroach-certs",
									"name": "certs",
									"readOnly": true
								},
								{
									"mountPath": "/cockroach/config",
									"name": "config",
									"readOnly": true
								},
								{
									"mountPath": "/etc/ssl/certs/tenant-ca.crt",
									"name": "tenant-ca-certificate",
									"readOnly": true,
									"subPath": "tenant-ca.crt"
								},
								{
									"mountPath": "/cockroach/inflight_trace_dump",
									"name": "inflightdir"
								}
							]
						},
						{
							"command": [
								"/bin/tenantdir",
								"--listen-addr=0.0.0.0:8081",
								"--operator-addr=cockroach-operator.default.svc:9070"
							],
							"env": [
								{
									"name": "K8S_NAMESPACE",
									"valueFrom": {
										"fieldRef": {
											"fieldPath": "metadata.namespace"
										}
									}
								}
							],
							"image": "us-docker.pkg.dev/cockroach-cloud-images/data-plane/tenantdir:master",
							"imagePullPolicy": "IfNotPresent",
							"name": "tenantdir",
							"ports": [
								{
									"containerPort": 8081,
									"name": "http",
									"protocol": "TCP"
								},
								{
									"containerPort": 8082,
									"name": "td-prometheus",
									"protocol": "TCP"
								}
							],
							"readinessProbe": {
								"grpc": {
									"port": 8081,
									"service": null
								},
								"successThreshold": 2
							},
							"resources": {},
							"securityContext": {
								"allowPrivilegeEscalation": false,
								"capabilities": {
									"drop": [
										"ALL"
									]
								},
								"privileged": false,
								"readOnlyRootFilesystem": true
							},
							"volumeMounts": [
								{
									"mountPath": "/certs",
									"name": "tenantdir-certs"
								}
							]
						},
						{
							"args": [
								"cockroach",
								"/cockroach/cockroach-certs",
								"/cockroach/config"
							],
							"image": "us-docker.pkg.dev/cockroach-cloud-images/data-plane/inotifywait:87edf086db32734c7fa083a62d1055d664900840",
							"imagePullPolicy": "IfNotPresent",
							"name": "cert-reloader",
							"resources": {},
							"securityContext": {
								"allowPrivilegeEscalation": false,
								"capabilities": {
									"drop": [
										"ALL"
									]
								},
								"privileged": false,
								"readOnlyRootFilesystem": true
							},
							"volumeMounts": [
								{
									"mountPath": "/cockroach/cockroach-certs",
									"name": "certs",
									"readOnly": true
								},
								{
									"mountPath": "/cockroach/config",
									"name": "config",
									"readOnly": true
								}
							]
						}
					],
					"priorityClassName": "sqlproxy",
					"securityContext": {
						"fsGroup": 1000,
						"fsGroupChangePolicy": "OnRootMismatch",
						"runAsGroup": 1000,
						"runAsNonRoot": true,
						"runAsUser": 1000
					},
					"serviceAccountName": "sqlproxy",
					"shareProcessNamespace": true,
					"terminationGracePeriodSeconds": 3600,
					"volumes": [
						{
							"name": "certs",
							"secret": {
								"defaultMode": 288,
								"items": [
									{
										"key": "sql-proxy-external.crt",
										"path": "external.crt"
									},
									{
										"key": "sql-proxy-external.key",
										"path": "external.key"
									}
								],
								"secretName": "sql-proxy-external-certs"
							}
						},
						{
							"configMap": {
								"defaultMode": 256,
								"name": "sqlproxy-config"
							},
							"name": "config"
						},
						{
							"configMap": {
								"defaultMode": 256,
								"name": "sqlproxy-allowlist"
							},
							"name": "allowlist"
						},
						{
							"name": "tenant-ca-certificate",
							"secret": {
								"defaultMode": 288,
								"items": [
									{
										"key": "ca.crt",
										"path": "tenant-ca.crt"
									}
								],
								"secretName": "node-certs"
							}
						},
						{
							"name": "tenantdir-certs",
							"secret": {
								"defaultMode": 288,
								"secretName": "tenantdir-certs"
							}
						},
						{
							"emptyDir": {},
							"name": "inflightdir"
						}
					]
				}
			}
		},
		"status": {
			"availableReplicas": 3,
			"conditions": [
				{
					"lastTransitionTime": null,
					"lastUpdateTime": null,
					"status": "True",
					"type": "Available"
				},
				{
					"lastTransitionTime": null,
					"lastUpdateTime": null,
					"reason": "NewReplicaSetAvailable",
					"status": "True",
					"type": "Progressing"
				}
			],
			"observedGeneration": 1,
			"replicas": 3,
			"updatedReplicas": 3
		}
	},
	{
		"apiVersion": "apps/v1",
		"kind": "Deployment",
		"metadata": {
			"annotations": {},
