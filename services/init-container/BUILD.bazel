load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//build:base_images.bzl", "select_base_image_for_go_services")
load("//build:container.bzl", "data_plane_image", "oci_push", "oci_push_with_tags")
load("//build:redhat_labels.bzl", "get_redhat_labels")

go_library(
    name = "init-container_lib",
    srcs = ["main.go"],
    importpath = "github.com/cockroachlabs/cockroach-enterprise-operator/services/init-container",
    visibility = ["//visibility:private"],
    deps = [
        "//buildinfo",
        "//manifests",
        "//services/init-container/pkg/encryption",
        "//services/init-container/pkg/locality",
        "@com_github_cockroachdb_errors//:errors",
        "@in_gopkg_yaml_v2//:yaml_v2",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
    ],
)

go_binary(
    name = "init-container",
    embed = [":init-container_lib"],
    visibility = ["//visibility:public"],
)

data_plane_image(
    name = "container",
    base = select_base_image_for_go_services(),
    directory = "/bin/",
    files = [":init-container"],
    labels = get_redhat_labels("init-container"),
    # matches the pod-level RunAsUser set by securitycontext.PodRunAsNonRoot
    user = "1000",
)

oci_push(
    name = "push_local",
    image = ":container",
    # The `latest` tag matches what consumers in deploy/ and manifests/
    # expect; the `dev` tag is pushed alongside so local preflight runs can
    # target a non-`latest` reference and satisfy the HasUniqueTag check.
    remote_tags = [
        "latest",
        "dev",
    ],
    repository = "localhost:5000/init-container",
)

oci_push_with_tags(
    name = "push_development",
    image = ":container",
    repository = "us-docker.pkg.dev/cockroach-cloud-images/development/init-container",
    stamped_tags = ["STABLE_BUILD_TAG"],
)

oci_push_with_tags(
    name = "push_production_ubi",
    image = ":container",
    repository = "us-docker.pkg.dev/releases-prod/self-hosted/init-container",
    stamped_tags = [
        "STABLE_COMMIT_SHA",
        "STABLE_BRANCH_NAME",
        "STABLE_OPERATOR_VERSION_TAG",
    ],
)

oci_push_with_tags(
    name = "push_dockerhub",
    image = ":container",
    repository = "docker.io/cockroachdb/cockroachdb-init-container",
    stamped_tags = [
        "STABLE_OPERATOR_VERSION_TAG",
    ],
)
