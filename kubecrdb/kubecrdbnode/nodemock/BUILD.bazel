load("@io_bazel_rules_go//go:def.bzl", "go_library", "gomock")

go_library(
    name = "mocks",
    srcs = [":nodemock"],
    importpath = "github.com/cockroachlabs/cockroach-enterprise-operator/kubecrdb/kubecrdbnode/nodemock",
    visibility = ["//visibility:public"],
    deps = [
        "//api/v1beta1",
        "//kube",
        "@com_github_golang_mock//gomock",
    ],
)

gomock(
    name = "nodemock",
    out = "mocks_generated.go",
    interfaces = [
        "Executor",
        "NodeExecutor",
    ],
    library = "//kubecrdb/kubecrdbnode",
    package = "nodemock",
    visibility = ["//visibility:public"],
)
