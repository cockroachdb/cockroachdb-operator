load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test", "gomock")

go_library(
    name = "kubecrdbnode",
    srcs = ["exec.go"],
    importpath = "github.com/cockroachlabs/cockroach-enterprise-operator/kubecrdb/kubecrdbnode",
    visibility = ["//visibility:public"],
    deps = [
        "//api/v1beta1",
        "//kube",
        "//manifests",
        "//pkg/logging",
        "@com_github_cockroachdb_errors//:errors",
        "@com_github_cockroachlabs_version//:version",
        "@org_uber_go_zap//:zap",
    ],
)

go_test(
    name = "kubecrdbnode_test",
    srcs = ["exec_test.go"],
    deps = [
        ":kubecrdbnode",
        "//api/v1beta1",
        "//kube",
        "//kubecrdb/kubecrdbnode/nodemock:mocks",
        "//manifests",
        "@com_github_cockroachdb_errors//:errors",
        "@com_github_golang_mock//gomock",
        "@com_github_stretchr_testify//suite",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
    ],
)
