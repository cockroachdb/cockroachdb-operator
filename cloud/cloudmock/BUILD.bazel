load("@io_bazel_rules_go//go:def.bzl", "go_library", "gomock")

go_library(
    name = "mocks",
    srcs = [":cloudmock"],
    importpath = "github.com/cockroachlabs/cockroach-enterprise-operator/cloud/cloudmock",
    visibility = ["//visibility:public"],
    deps = [
        "//cloud",
        "@com_github_golang_mock//gomock",
    ],
)

gomock(
    name = "cloudmock",
    out = "mocks_generated.go",
    interfaces = ["CredentialProvider"],
    library = "//cloud",
    package = "cloudmock",
    visibility = ["//visibility:public"],
)
