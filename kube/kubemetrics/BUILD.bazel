load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "kubemetrics",
    srcs = ["metrics.go"],
    importpath = "github.com/cockroachlabs/cockroach-enterprise-operator/kube/kubemetrics",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_prometheus_client_golang//prometheus",
        "@io_k8s_client_go//tools/metrics",
    ],
)

go_test(
    name = "kubemetrics_test",
    srcs = ["metrics_test.go"],
    embed = [":kubemetrics"],
    deps = [
        "@com_github_stretchr_testify//require",
        "@io_k8s_client_go//tools/metrics",
    ],
)
