typemeta:
  kind: ""
  apiversion: ""
objectmeta:
  name: cockroachdb-logging-tenant
  generatename: ""
  namespace: ""
  selflink: ""
  uid: ""
  resourceversion: ""
  generation: 0
  creationtimestamp: "0001-01-01T00:00:00Z"
  deletiontimestamp: null
  deletiongraceperiodseconds: null
  labels: {}
  annotations: {}
  ownerreferences: []
  finalizers: []
  clustername: ""
  managedfields: []
immutable: null
data:
  logs.yaml: |
    file-defaults:
      dir: /cockroach/cockroach-data/logs
      max-file-size: 1.0MiB
      max-group-size: 1.0MiB
      buffered-writes: true
      filter: INFO
      format: crdb-v2
      redact: false
      redactable: true
      exit-on-error: true
      auditable: false
    fluent-defaults:
      filter: INFO
      format: json-fluent
      redact: false
      redactable: true
      exit-on-error: false
      auditable: false
    sinks:
      file-groups:
        default:
          channels: {INFO: [DEV, OPS, HEALTH, SQL_SCHEMA, USER_ADMIN, PRIVILEGES]}
        pebble:
          channels: {INFO: [STORAGE]}
        sql-audit:
          channels: {INFO: [SENSITIVE_ACCESS]}
        sql-auth:
          channels: {INFO: [SESSIONS]}
        sql-exec:
          channels: {INFO: [SQL_EXEC]}
        sql-slow:
          channels: {INFO: [SQL_PERF]}
        sql-slow-internal-only:
          channels: {INFO: [SQL_INTERNAL_PERF]}
        telemetry:
          channels: {INFO: [TELEMETRY]}
      fluent-servers:
        fluentbit-customer:
          channels: {INFO: [SESSIONS, OPS, HEALTH, STORAGE, SQL_SCHEMA, USER_ADMIN, PRIVILEGES,
              SENSITIVE_ACCESS, SQL_EXEC, SQL_PERF]}
          net: tcp
          address: ${HOST_IP}:5171
          filter: INFO
          redact: true
        fluentbit-redacted:
          channels: {INFO: [SESSIONS, DEV, OPS, HEALTH, STORAGE, SQL_SCHEMA, USER_ADMIN,
              PRIVILEGES, SENSITIVE_ACCESS, SQL_EXEC, SQL_PERF, TELEMETRY]}
          net: tcp
          address: ${HOST_IP}:5170
          filter: INFO
          redact: true
      stderr:
        channels: {}
        filter: INFO
        format: crdb-v2-tty
        redact: true
        exit-on-error: true
    capture-stray-errors:
      enable: true
      max-group-size: 1.0MiB
binarydata: {}
