{
	"metadata": {
		"name": "test",
		"namespace": "testns",
		"creationTimestamp": null,
		"labels": {
			"app": "cockroachdb",
			"cluster": "",
			"crdb.cockroachlabs.com/cluster": "crdb-test",
			"crdb.cockroachlabs.com/podName": "test",
			"svc": "cockroachdb"
		},
		"annotations": {
			"crdb.cockroachlabs.com/nodeGeneration": "0",
			"crdb.cockroachlabs.com/nodeRevision": "e0ee3eebb884fe80"
		}
	},
	"spec": {
		"volumes": [
			{
				"name": "datadir",
				"persistentVolumeClaim": {
					"claimName": "testpvc-test"
				}
			},
			{
				"name": "cockroach-env",
				"emptyDir": {}
			},
			{
				"name": "certs",
				"projected": {
					"sources": [
						{
							"secret": {
								"name": "node-certs",
								"items": [
									{
										"key": "tls.crt",
										"path": "node.crt"
									},
									{
										"key": "tls.key",
										"path": "node.key"
									}
								]
							}
						},
						{
							"secret": {
								"name": "client-certs",
								"items": [
									{
										"key": "tls.crt",
										"path": "client.root.crt"
									},
									{
										"key": "tls.key",
										"path": "client.root.key"
									}
								]
							}
						},
						{
							"secret": {
								"name": "node-client-certs",
								"items": [
									{
										"key": "tls.crt",
										"path": "client.node.crt"
									},
									{
										"key": "tls.key",
										"path": "client.node.key"
									}
								]
							}
						},
						{
							"secret": {
								"name": "ui-certs",
								"items": [
									{
										"key": "tls.crt",
										"path": "ui.crt"
									},
									{
										"key": "tls.key",
										"path": "ui.key"
									}
								]
							}
						},
						{
							"configMap": {
								"name": "node-ca",
								"items": [
									{
										"key": "ca.crt",
										"path": "ca.crt"
									}
								]
							}
						},
						{
							"configMap": {
								"name": "client-ca",
								"items": [
									{
										"key": "ca.crt",
										"path": "ca-client.crt"
									}
								]
							}
						}
					],
					"defaultMode": 288
				}
			},
			{
				"name": "cockroachdb-logging",
				"configMap": {
					"name": "logging-test"
				}
			}
		],
		"initContainers": [
			{
				"name": "cockroachdb-init",
				"image": "us-docker.pkg.dev/cockroach-cloud-images/data-plane/init-container:latest",
				"command": [
					"init-container",
					"-locality-dest",
					"/etc/cockroach-env"
				],
				"env": [
					{
						"name": "KUBERNETES_NODE",
						"valueFrom": {
							"fieldRef": {
								"fieldPath": "spec.nodeName"
							}
						}
					},
					{
						"name": "PUSHGATEWAY_NAMESPACE",
						"value": "monitoring-testns"
					},
					{
						"name": "ERROR_ON_MISSING_LABELS",
						"value": "1"
					}
				],
				"resources": {},
				"volumeMounts": [
					{
						"name": "cockroach-env",
						"mountPath": "/etc/cockroach-env"
					}
				]
			}
		],
		"containers": [
			{
				"name": "cockroachdb",
				"image": "testimage",
				"command": [
					"/bin/bash",
					"-exc",
					"ulimit -S -n 1048576;  exec /cockroach/cockroach start --certs-dir /cockroach/cockroach-certs --listen-addr 0.0.0.0:26258 --http-addr 0.0.0.0:8080 --sql-addr 0.0.0.0:26257 --advertise-addr test.crdb-test.testns.svc.cluster.local:26258 --advertise-sql-addr test.crdb-test.testns.svc.cluster.local:26257 --join  $(cat /etc/cockroach-env/locality),dns=test.crdb-test.testns.svc.cluster.local --log-config-file=/cockroach/config/logs.yaml --log-config-vars=HOST_IP --cache=25% --max-sql-memory=25%"
				],
				"ports": [
					{
						"name": "grpc",
						"containerPort": 26258,
						"protocol": "TCP"
					},
					{
						"name": "http",
						"containerPort": 8080,
						"protocol": "TCP"
					},
					{
						"name": "sql",
						"containerPort": 26257,
						"protocol": "TCP"
					}
				],
				"env": [
					{
						"name": "COCKROACH_CERTS_DIR",
						"value": "/cockroach/cockroach-certs"
					},
					{
						"name": "COCKROACH_HOST",
						"value": "localhost:26257"
					},
					{
						"name": "COCKROACH_RPC_PORT",
						"value": "26258"
					},
					{
						"name": "COCKROACH_SQL_PORT",
						"value": "26257"
					},
					{
						"name": "HOST_IP",
						"valueFrom": {
							"fieldRef": {
								"apiVersion": "v1",
								"fieldPath": "status.hostIP"
							}
						}
					}
				],
				"resources": {
					"limits": {
						"memory": "0"
					},
					"requests": {
						"memory": "0"
					}
				},
				"volumeMounts": [
					{
						"name": "certs",
						"readOnly": true,
						"mountPath": "/cockroach/cockroach-certs"
					},
					{
						"name": "cockroach-env",
						"readOnly": true,
						"mountPath": "/etc/cockroach-env"
					},
					{
						"name": "datadir",
						"mountPath": "/cockroach/cockroach-data"
					},
					{
						"name": "cockroachdb-logging",
						"readOnly": true,
						"mountPath": "/cockroach/config"
					}
				],
				"readinessProbe": {
					"httpGet": {
						"path": "/health?ready=1",
						"port": "http",
						"scheme": "HTTPS"
					},
					"initialDelaySeconds": 10,
					"timeoutSeconds": 10,
					"periodSeconds": 10,
					"successThreshold": 1,
					"failureThreshold": 2
				},
				"securityContext": {
					"capabilities": {
						"drop": [
							"ALL"
						]
					},
					"privileged": false,
					"readOnlyRootFilesystem": true,
					"allowPrivilegeEscalation": false
				}
			},
			{
				"name": "cert-reloader",
				"image": "us-docker.pkg.dev/cockroach-cloud-images/data-plane/inotifywait:87edf086db32734c7fa083a62d1055d664900840",
				"args": [
					"cockroach",
					"/cockroach/cockroach-certs"
				],
				"resources": {},
				"volumeMounts": [
					{
						"name": "certs",
						"readOnly": true,
						"mountPath": "/cockroach/cockroach-certs"
					}
				],
				"imagePullPolicy": "IfNotPresent",
				"securityContext": {
					"capabilities": {
						"drop": [
							"ALL"
						]
					},
					"privileged": false,
					"readOnlyRootFilesystem": true,
					"allowPrivilegeEscalation": false
				}
			}
		],
		"terminationGracePeriodSeconds": 2700,
		"serviceAccountName": "testsa",
		"shareProcessNamespace": true,
		"securityContext": {
			"runAsUser": 1000,
			"runAsGroup": 1000,
			"runAsNonRoot": false,
			"fsGroup": 1000,
			"fsGroupChangePolicy": "OnRootMismatch"
		},
		"hostname": "test",
		"subdomain": "crdb-test",
		"affinity": {
			"podAntiAffinity": {
				"requiredDuringSchedulingIgnoredDuringExecution": [
					{
						"labelSelector": {
							"matchLabels": {
								"app": "cockroachdb",
								"crdb.cockroachlabs.com/cluster": "crdb-test"
							}
						},
						"namespaces": [
							"testns"
						],
						"topologyKey": "kubernetes.io/hostname"
					}
				]
			}
		},
		"priorityClassName": "crdb-critical"
	},
	"status": {}
}