ulimit -S -n 1048576;  exec /cockroach/cockroach start --insecure --listen-addr 0.0.0.0:26258 --http-addr 0.0.0.0:8080 --sql-addr 0.0.0.0:26257 --advertise-addr majortom.groundcontrol.flags.svc.cluster.local:26258 --advertise-sql-addr majortom.groundcontrol.flags.svc.cluster.local:26257 --join test-join --locality dns=majortom.groundcontrol.flags.svc.cluster.local --log='sinks: {stderr: {channels: {INFO: "HEALTH,OPS,DEV,STORAGE"}}}' --cache=25% --max-sql-memory=25% --basalt-cluster="default@$BASALT_CONTROLLER_ADDRS" --basalt-namespace="$BASALT_TENANT_ID" --store="path=basalt://$BASALT_TENANT_ID@default/majortom/store"