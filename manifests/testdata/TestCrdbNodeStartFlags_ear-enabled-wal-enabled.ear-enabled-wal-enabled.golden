ulimit -S -n 1048576;  exec /cockroach/cockroach start --advertise-addr=majortom.groundcontrol.flags.svc.cluster.local:26258 --advertise-sql-addr=majortom.groundcontrol.flags.svc.cluster.local:26257 --cache=25% --certs-dir=/cockroach/cockroach-certs --http-addr=0.0.0.0:8080 --join=test-join --listen-addr=0.0.0.0:26258 --locality=dns=majortom.groundcontrol.flags.svc.cluster.local --log='sinks: {stderr: {channels: {INFO: "HEALTH,OPS", WARNING: "STORAGE,DEV"}}}' --max-sql-memory=25% --sql-addr=0.0.0.0:26257 --wal-failover=path=/cockroach/wal_failover --enterprise-encryption=path=cockroach-data,key=/etc/cockroach-key/new_store.key,old-key=plain,rotation-period=720h --enterprise-encryption=path=/cockroach/wal_failover,key=/etc/cockroach-key/new_store.key,old-key=plain,rotation-period=720h