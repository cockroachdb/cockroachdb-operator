load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//build:base_images.bzl", "select_base_image_for_go_services")
load("//build:container.bzl", "data_plane_image", "oci_push_all", "oci_push_with_tags")
load("//build:redhat_labels.bzl", "get_redhat_labels")
load("//build/gen:go_binaries.bzl", "GO_BINARIES_SRCS")

exports_files([
    "DEPS.bzl",
    "VERSION",
    "WORKSPACE",
    "go.mod",
    "go.sum",
    "LICENSE",
])

# Shared LICENSE layer for all container images (Red Hat certification requirement)
pkg_tar(
    name = "license_layer",
    srcs = ["LICENSE"],
    extension = "tar.gz",
    package_dir = "/licenses",
    visibility = ["//visibility:public"],
)

# The following directives inform gazelle how to auto-generate BUILD.bazel
# files throughout the repo. By including them here, we can run gazelle using
# `bazel run //:gazelle` instead of invoking gazelle directly.
#
# NB: Be sure to re-generate BUILD.bazel files if any of the directives below
# are changed.

# Define the gazelle prefix and what the autogenerated BUILD files should be
# named as.
#
# gazelle:prefix github.com/cockroachlabs/cockroach-enterprise-operator
# gazelle:build_file_name BUILD.bazel
# gazelle:build_tags bazel,production
#
# gazelle:proto package
# gazelle:proto_group go_package
# gazelle:go_grpc_compilers @io_bazel_rules_go//proto:go_grpc
# gazelle:go_proto_compilers @io_bazel_rules_go//proto:go_proto

# Add resolve rules for gooogleapi protos. See https://github.com/bazelbuild/bazel-gazelle/releases/tag/v0.32.0
# gazelle:resolve proto proto google/api/httpbody.proto @googleapis//google/api:httpbody_proto
# gazelle:resolve proto go    google/api/httpbody.proto @org_golang_google_genproto_googleapis_api//httpbody
# gazelle:resolve proto proto google/api/annotations.proto  @googleapis//google/api:annotations_proto
# gazelle:resolve proto go    google/api/annotations.proto  @org_golang_google_genproto_googleapis_api//annotations
# gazelle:resolve proto proto google/api/visibility.proto  @googleapis//google/api:visibility_proto
# gazelle:resolve proto go    google/api/visibility.proto  @org_golang_google_genproto_googleapis_api//visibility
# gazelle:resolve proto google/longrunning/operations.proto @googleapis//google/longrunning:operations_proto
# gazelle:resolve proto go google/longrunning/operations.proto @org_golang_google_genproto//googleapis/longrunning

# gazelle:exclude _bazel
# gazelle:exclude bin
# gazelle:exclude bin.docker
# gazelle:exclude build/node_modules
# gazelle:exclude conf
# gazelle:exclude config
# gazelle:exclude contrib
# gazelle:exclude deploy
# gazelle:exclude docs
# gazelle:exclude e2e-tests
# gazelle:exclude infra
# gazelle:exclude ops
# gazelle:exclude scripts
# gazelle:exclude vendor
# gazelle:exclude **/*.pb.go
# gazelle:exclude **/*.pb.gw.go
# gazelle:exclude **/*.validator.pb.go
# gazelle:exclude **/*_generated.go
# gazelle:exclude **/*_generated_test.go
# gazelle:exclude **/testdata/**/*.go

gazelle(
    name = "gazelle",
    tags = ["manual"],
)

gazelle(
    name = "gazelle-update-repos",
    args = [
        "-from_file=go.mod",
        "-to_macro=DEPS.bzl%go_dependencies",
        "-prune",
        "-build_file_proto_mode=disable",
    ],
    command = "update-repos",
    tags = ["manual"],
)

# This is the target platform for CI, production, and Intel silicon
# developer computers.
# NB: If building containers on x86 machines, this is the default.
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

# This is the target platform for the Docker VM on developers' Apple
# silicon computers.
# NB: If building containers on Apple silicon computers, this is the default.
platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:linux",
    ],
)

filegroup(
    name = "go_binaries",
    srcs = GO_BINARIES_SRCS,
)

go_library(
    name = "cockroach-operator_lib",
    srcs = ["main.go"],
    importpath = "github.com/cockroachlabs/cockroach-enterprise-operator",
    visibility = ["//visibility:private"],
    deps = [
        "//buildinfo",
        "//cloud",
        "//kube",
        "//manager",
        "//manifests",
        "//pkg/logging",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/util/validation",
        "@io_k8s_sigs_controller_runtime//:controller-runtime",
    ],
)

go_binary(
    name = "cockroach-operator",
    embed = [":cockroach-operator_lib"],
    visibility = ["//visibility:public"],
)

data_plane_image(
    name = "container",
    base = select_base_image_for_go_services(),
    directory = "/bin/",
    entrypoint = ["cockroach-operator"],
    files = [":cockroach-operator"],
    labels = get_redhat_labels("operator"),
)

oci_push_all(
    name = "push_local",
    image_config = {
        "localhost:5000/cockroach-operator": ":container",
        "localhost:5000/init-container": "//services/init-container:container",
    },
    # The `latest` tag is required by deploy/values.yaml and the operator
    # manifest in manifests/internal/yaml/cockroach-operator.yaml. The `dev`
    # tag is pushed alongside so local preflight runs can use a non-`latest`
    # reference and satisfy the HasUniqueTag check.
    static_tags = [
        "latest",
        "dev",
    ],
)

oci_push_all(
    name = "push_local_operator",
    image_config = {
        "localhost:5000/cockroach-operator": ":container",
    },
    static_tags = [
        "latest",
        "dev",
    ],
)

# usage :push_development --stamp
oci_push_all(
    name = "push_development",
    image_config = {
        "us-docker.pkg.dev/cockroach-cloud-images/development/cockroach-operator": ":container",
        "us-docker.pkg.dev/cockroach-cloud-images/development/init-container": "//services/init-container:container",
    },
    stamped_tags = [
        "STABLE_BUILD_TAG",
    ],
)

# usage :push_development_operator --stamp
oci_push_all(
    name = "push_development_operator",
    image_config = {
        "us-docker.pkg.dev/cockroach-cloud-images/development/cockroach-operator": ":container",
    },
    stamped_tags = [
        "STABLE_BUILD_TAG",
    ],
)

# oci_push_with_tags(
#    name = "push_development",
#    image = ":container",
#    repository = "us-docker.pkg.dev/cockroach-cloud-images/development/cockroach-operator",
#    stamped_tags = ["STABLE_BUILD_TAG"],
# )

alias(
    name = "push_dev",
    actual = ":push_development",
)

oci_push_all(
    name = "push_production",
    image_config = {
        "us-docker.pkg.dev/cockroach-cloud-images/data-plane/cockroach-operator": ":container",
        "us-docker.pkg.dev/cockroach-cloud-images/data-plane/init-container": "//services/init-container:container",
    },
    stamped_tags = [
        "STABLE_COMMIT_SHA",
        "STABLE_BRANCH_NAME",
    ],
)

oci_push_with_tags(
    name = "push_production_ubi",
    image = ":container",
    repository = "us-docker.pkg.dev/releases-prod/self-hosted/cockroachdb-operator",
    stamped_tags = [
        "STABLE_COMMIT_SHA",
        "STABLE_BRANCH_NAME",
        "STABLE_OPERATOR_VERSION_TAG",
    ],
)

oci_push_with_tags(
    name = "push_dockerhub",
    image = ":container",
    repository = "docker.io/cockroachdb/cockroachdb-operator-v2",
    stamped_tags = [
        "STABLE_OPERATOR_VERSION_TAG",
    ],
)
